# PromoHive Global Promo Network - Environment Configuration

# Database Configuration
DATABASE_URL="postgresql://neondb_owner:npg_rM8TdPYHz9eR@ep-lively-snow-adwxcbb2-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT Configuration
JWT_SECRET="promohive-super-secret-jwt-key-2024-change-in-production"
JWT_EXPIRES_IN="7d"

# Admin Configuration
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@promohive.com"

# Email Configuration (Hostinger)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="promohive@globalpromonetwork.store"
SMTP_PASS="〈PromoHive@2025!〉"
SMTP_SECURE=true
SMTP_FROM="promohive@globalpromonetwork.store"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Payment Gateways
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# Social Media OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# File Upload
UPLOAD_MAX_SIZE="10485760"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,video/mp4,application/pdf"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application Settings
APP_NAME="PromoHive Global Promo Network"
APP_URL="http://localhost:8080"
FRONTEND_URL="http://localhost:8080"

# Level System Configuration
LEVEL_0_MAX_EARNINGS=9.90
LEVEL_1_REWARD_LIMIT=70
LEVEL_2_REWARD_LIMIT=130
LEVEL_3_REWARD_LIMIT=180

# Referral System
REFERRAL_BONUS_AMOUNT=5.00
WELCOME_BONUS_AMOUNT=5.00

# Withdrawal Settings
MIN_WITHDRAWAL_AMOUNT=10.00
WITHDRAWAL_PROCESSING_FEE=0.00

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Analytics
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
ENABLE_ANALYTICS=true

# Development
NODE_ENV="development"
LOG_LEVEL="debug"

# WhatsApp Integration
WHATSAPP_PHONE_NUMBER="+17253348692"
WHATSAPP_API_URL="https://api.whatsapp.com/send"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# CDN Configuration
CDN_URL="https://cdn.promohive.com"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Monitoring
SENTRY_DSN="your-sentry-dsn"
LOG_LEVEL="info"

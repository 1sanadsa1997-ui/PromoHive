# PromoHive Production Environment Configuration
# Copy this file to .env.production on the server

# Database Configuration
DATABASE_URL="postgresql://neondb_owner:npg_rM8TdPYHz9eR@ep-lively-snow-adwxcbb2-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT Configuration
JWT_SECRET="promohive-production-super-secret-jwt-key-2024-change-this"
JWT_EXPIRES_IN="7d"

# Admin Configuration
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@promohive.com"

# Email Configuration (Hostinger)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="promohive@globalpromonetwork.store"
SMTP_PASS="〈PromoHive@2025!〉"
SMTP_SECURE=true
SMTP_FROM="promohive@globalpromonetwork.store"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Payment Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"

# OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Application Configuration
NODE_ENV="production"
PORT=8080
HOST="0.0.0.0"

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH="./uploads"

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"

# Monitoring Configuration
ENABLE_MONITORING=true
METRICS_PORT=9090

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_REFERRALS=true
ENABLE_WITHDRAWALS=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# Level System Configuration
LEVEL_0_MAX_EARNINGS=9.90
LEVEL_1_REWARD_LIMIT=70
LEVEL_2_REWARD_LIMIT=130
LEVEL_3_REWARD_LIMIT=180

# Referral System Configuration
REFERRAL_BONUS_AMOUNT=5.00
WELCOME_BONUS_AMOUNT=5.00
MIN_WITHDRAWAL_AMOUNT=10.00

# WhatsApp Support
WHATSAPP_NUMBER="+17253348692"
SUPPORT_EMAIL="support@promohive.com"

# Domain Configuration
APP_URL="https://int.hostingervps.com"
ADMIN_URL="https://int.hostingervps.com/admin"
API_URL="https://int.hostingervps.com/api"

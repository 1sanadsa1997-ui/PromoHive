# Supabase Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-side Supabase (for Vite)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database (Legacy - for Prisma if needed)
DATABASE_URL="postgresql://username:password@localhost:5432/ibrahim_accounting"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Admin Configuration (Ibrahim System Owner)
ADMIN_PASSWORD="ibrahim123"
ADMIN_EMAIL="systemibrahem@gmail.com"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="PromoHive <noreply@promohive.com>"

# SMS Configuration
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Payment Gateways
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# Social Media OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# File Upload
UPLOAD_MAX_SIZE="10485760" # 10MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,video/mp4,application/pdf"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Application Settings
APP_NAME="نظام إبراهيم للمحاسبة - Ibrahim Accounting System"
APP_URL="http://localhost:8080"
FRONTEND_URL="http://localhost:8080"

# Level System Configuration
LEVEL_0_MAX_EARNINGS=9.90
LEVEL_1_REWARD_LIMIT=70
LEVEL_2_REWARD_LIMIT=130
LEVEL_3_REWARD_LIMIT=180

# Referral System
REFERRAL_BONUS_AMOUNT=5.00
WELCOME_BONUS_AMOUNT=5.00

# Withdrawal Settings
MIN_WITHDRAWAL_AMOUNT=10.00
WITHDRAWAL_PROCESSING_FEE=0.00

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Analytics
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
ENABLE_ANALYTICS=true

# Development
NODE_ENV="development"
LOG_LEVEL="debug"

# WhatsApp Integration (Ibrahim Support)
WHATSAPP_PHONE_NUMBER="+963994054027"
WHATSAPP_API_URL="https://api.whatsapp.com/send"
WHATSAPP_SUPPORT_MESSAGE="مرحباً، أريد الاستفسار عن نظام إبراهيم للمحاسبة"

# Firebase Configuration (for notifications)
FIREBASE_PROJECT_ID="ibrahim-accounting-system"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@ibrahim-accounting-system.iam.gserviceaccount.com"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# CDN Configuration
CDN_URL="https://cdn.promohive.com"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Monitoring
SENTRY_DSN="your-sentry-dsn"
LOG_LEVEL="info"
